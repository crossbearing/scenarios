{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AuditReadConfig",
      "Effect": "Allow",
      "Action": [
        "sts:GetCallerIdentity",
        "s3:GetBucketVersioning",
        "s3:GetBucketPolicy",
        "s3:GetBucketAcl",
        "s3:GetEncryptionConfiguration"
      ],
      "Resource": [
        "arn:aws:s3:::prod-payments-config"
      ]
    },
    {
      "Sid": "DenyBucketPolicyWrites",
      "Effect": "Deny",
      "Action": [
        "s3:PutBucketPolicy",
        "s3:DeleteBucketPolicy"
      ],
      "Resource": [
        "arn:aws:s3:::prod-payments-config"
      ]
    }
  ]
}
