{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AgentDeployAssume",
      "Effect": "Allow",
      "Principal": {
        "Federated": "arn:aws:iam::111122223333:oidc-provider/oidc.example-idp.com"
      },
      "Action": [
        "sts:AssumeRoleWithWebIdentity",
        "sts:TagSession"
      ],
      "Condition": {
        "StringEquals": {
          "oidc.example-idp.com:aud": "sts.amazonaws.com"
        }
      }
    }
  ]
}
