{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "HumanAssumesAgentRunnerWithIdentity",
      "Effect": "Allow",
      "Principal": {
        "AWS": "arn:aws:iam::111122223333:role/aws-reserved/sso.amazonaws.com/AWSReservedSSO_Engineer_a1b2c3d4"
      },
      "Action": [
        "sts:AssumeRole",
        "sts:SetSourceIdentity"
      ],
      "Condition": {
        "StringLike": {
          "sts:SourceIdentity": "*@example.com"
        }
      }
    }
  ]
}
